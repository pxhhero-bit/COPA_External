  "field_semantics": {
    "note": "COPA 契约字段的语义说明，只描述字段含义、单位与合法取值，不列举原文别名。原文说法与契约字段/枚举的对应关系由模型按语义自行推断；契约没列出的说法同样推断后交由 COPA 校验，校验不通过时保持缺失，不得因为没见过某种说法就拒绝映射。非契约列一律忽略。",
    "fields": {
      "item_type": {
        "hint": "设备类型枚举：称重模块 / 台秤 / 平台秤。"
      },
      "quantity": {
        "hint": "该条设备的数量，正整数。"
      },
      "W1": {
        "unit": "kg",
        "hint": "最大物料重量，kg 数值。"
      },
      "W2": {
        "unit": "kg",
        "hint": "设备自重，kg 数值，可为 0；仅称重模块需要。"
      },
      "台面尺寸": {
        "hint": "长x宽，单位 mm；米/厘米换算成 mm。"
      },
      "material": {
        "hint": "整机材质：碳钢 / 不锈钢 / 混合。"
      },
      "m_brand": {
        "hint": "整单共用的秤体/传感器品牌短码，写在 quote，不在条目里。"
      },
      "c_brand": {
        "hint": "整单共用的仪表/控制器品牌短码，写在 quote，不在条目里。"
      },
      "安装形式": {
        "hint": "台秤安装形式：一体 / 分体。"
      },
      "分体仪表支架": {
        "hint": "分体时的仪表支架枚举，按原文语义自行选择合法取值。"
      },
      "required_ex": {
        "hint": "防爆等级枚举；原文只给『防爆』而未给具体等级时属于缺项。"
      },
      "power": {
        "hint": "仪表电源，可选字段。"
      }
    },
