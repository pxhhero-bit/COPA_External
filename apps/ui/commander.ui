   <string notr="true">QMdiSubWindow {
    background-color: #F3F3F3;
    border: 1px solid #444444;
    color: rgb(0, 0, 0);
}

/* 标题栏区域（通过内部布局控制） */
QMdiSubWindow &gt; QWidget {
    background-color: rgb(255, 255, 255);
    color: rgb(0, 0, 0);
}
QMainWindow {background-color: rgb(117, 117, 117)}</string>
