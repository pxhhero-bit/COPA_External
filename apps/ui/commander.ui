   <property name="styleSheet">
    <string notr="true">/* 菜单栏背景 */
QMenuBar {
    background-color: rgb(234, 234, 234);
    color: rgb(0, 0, 0);
}

/* 菜单栏项：鼠标悬停/选中时的样式 */
QMenuBar::item:selected {
    background-color: rgb(222, 222, 222);  /* 选中背景色 */
    color: rgb(0, 0, 0);             /* 选中文字色 */
    border-radius: 4px;
}

/* 菜单栏项：按下时的样式 */
QMenuBar::item:pressed {
    background-color: rgb(222, 222, 222);
    color: rgb(0, 0, 0);
}

/* 下拉菜单整体背景 */
QMenu {
    background-color: rgb(255, 255, 255);
    color: rgb(0, 0, 0);
    border: 1px solid #444444;
}

/* 下拉菜单项：悬停/选中 */
QMenu::item:selected {
    background-color: rgb(222, 222, 222);
    color: rgb(0, 0, 0);
    border-radius: 3px;
}

/* 下拉菜单项：禁用状态 */
QMenu::item:disabled {
    color: #888888;
}

/* 分隔线颜色 */
QMenu::separator {
    background-color: #444444;
    height: 1px;
    margin: 4px 8px;
}</string>
