  <property name="styleSheet">
   <string notr="true">#LlmChat { background-color: #f7f8fa; }
#composerCard { background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: 16px; }
#messageEdit { border: none; background-color: transparent; color: #1f2329; font-size: 13px; }
#statusLabel { color: #6b7280; font-size: 11px; }
#hintLabel { color: #9aa1ad; font-size: 11px; }
#modelIntroLabel { color: #6b7280; font-size: 11px; }
QComboBox#modelCombo { border: none; background-color: transparent; color: #374151; padding: 2px 4px; }
QComboBox#modelCombo:hover { background-color: #f1f2f4; border-radius: 6px; }
QComboBox#modelCombo::drop-down { border: none; width: 16px; }
QToolButton#attachButton { border: none; border-radius: 6px; color: #4b5563; font-size: 18px; }
QToolButton#attachButton:hover { background-color: #f1f2f4; }
QPushButton#sendButton { background-color: #2f6fed; color: #ffffff; border: none; border-radius: 17px; font-size: 16px; }
QPushButton#sendButton:hover { background-color: #2563d8; }
QPushButton#sendButton:disabled { background-color: #c9d2e3; }
QToolButton#demoButton, QToolButton#newSessionButton { background-color: #ffffff; border: 1px solid #e3e5ea; border-radius: 10px; color: #4b5563; font-size: 11px; padding: 6px 2px; }
QToolButton#demoButton:hover, QToolButton#newSessionButton:hover { background-color: #ffffff; border-color: #c9ced9; color: #1f2329; }
QToolButton#demoButton:disabled, QToolButton#newSessionButton:disabled { color: #b8bdc7; border-color: #eef0f3; }</string>
